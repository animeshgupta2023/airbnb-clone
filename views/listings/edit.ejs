<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Wanderlust</title>
    </head>
    <body>
        <h3>Edit Listing</h3>
        <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
            <input name="listing[title]" value="<%= listing.title  %>" type="text">
            <br><br>
            <textarea name="listing[description]" value="<%= listing.description  %>" type="text" cols="50" rows="5"><%= listing.description  %></textarea>
            <br><br>
            <input name="listing[image][url]" value="<%= listing.image.url  %>" type="text">
            <br><br>
            <input name="listing[price]" value="<%= listing.price  %>" type="number">
            <br><br>
            <input name="listing[country]" value="<%= listing.country  %>" type="text">
            <br><br>
            <input name="listing[location]" value="<%= listing.location  %>" type="text">
            <br><br>
            <button>Edit</button>
        </form>
    </body>
</html>